+   out->WaitingForInterrupt=in->WaitingForInterrupt;
+   out->InDMA=in->InDMA;
+   out->WhichEvent=in->WhichEvent;
+   out->PC=(uint32_t)(uintptr_t)in->PC;
+   out->PCBase=(uint32_t)(uintptr_t)in->PCBase;
+   out->PCAtOpcodeStart=(uint32_t)(uintptr_t)in->PCAtOpcodeStart;
+   out->WaitAddress=(uint32_t)(uintptr_t)in->WaitAddress;
+   out->WaitCounter=in->WaitCounter;
+   out->Cycles=in->Cycles;
+   out->NextEvent=in->NextEvent;
+   out->V_Counter=in->V_Counter;
+   out->MemSpeed=in->MemSpeed;
+   out->MemSpeedx2=in->MemSpeedx2;
+   out->FastROMSpeed=in->FastROMSpeed;
+   out->SaveStateVersion=in->SaveStateVersion;
+   out->SRAMModified=in->SRAMModified;
+   out->NMITriggerPoint=in->NMITriggerPoint;
+   out->UNUSED2=in->UNUSED2;
+   out->TriedInterleavedMode2=in->TriedInterleavedMode2;
+   out->NMICycleCount=in->NMICycleCount;
+   out->IRQCycleCount=in->IRQCycleCount;
