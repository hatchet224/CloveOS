#!/bin/sh
set -eu

card=/mnt/SDCARD
base="$card/.console"
test -d "$base" && test ! -L "$base"
/bin/busybox awk '$2 == "/mnt/SDCARD" && $3 == "vfat" { found=1 } END { exit !found }' /proc/mounts
umask 077

case "${1-}" in
  retroarch)
    profile="$base/standalone-retroarch"
    saves="$card/Saves/StandaloneRetroArch"
    for path in "$profile" "$profile/config" "$profile/remaps" "$card/Saves" "$saves" "$saves/saves" "$saves/states"; do
        test ! -L "$path"
        /bin/busybox mkdir -p "$path"
    done
    config="$profile/retroarch.cfg"
    test ! -L "$config"
    if [ ! -e "$config" ]; then
        pending="$profile/.retroarch.cfg.new"
        test ! -L "$pending"
        /bin/busybox awk '
            !/^(config_save_on_exit|auto_overrides_enable|auto_remaps_enable|core_options_path|input_remapping_directory|savefile_directory|savestate_directory|input_enable_hotkey_btn|input_menu_toggle_btn|input_save_state_btn|input_load_state_btn|input_toggle_fast_forward_btn|input_state_slot_decrease_btn|input_state_slot_increase_btn|game_specific_options|global_core_options|rgui_config_directory|rgui_browser_directory|content_history_path|content_favorites_path)[[:space:]]*=/ { print }
        ' /etc/console/retroarch.cfg >"$pending"
        {
            printf 'config_save_on_exit = "true"\nauto_overrides_enable = "true"\nauto_remaps_enable = "true"\ngame_specific_options = "true"\nglobal_core_options = "true"\n'
            printf 'input_enable_hotkey_btn = "nul"\ninput_menu_toggle_btn = "19"\n'
            printf 'core_options_path = "%s/core-options.cfg"\nrgui_config_directory = "%s/config"\n' "$profile" "$profile"
            printf 'input_remapping_directory = "%s/remaps"\n' "$profile"
            printf 'savefile_directory = "%s/saves"\nsavestate_directory = "%s/states"\n' "$saves" "$saves"
            printf 'rgui_browser_directory = "%s/Roms"\ncontent_history_path = "%s/content_history.lpl"\n' "$card" "$profile"
            printf 'content_favorites_path = "%s/content_favorites.lpl"\n' "$profile"
        } >>"$pending"
        /bin/busybox mv -f "$pending" "$config"
    fi
    test -f "$config"
    options="$profile/core-options.cfg"
    test ! -L "$options"
    if [ ! -e "$options" ]; then
        pending=$(/bin/busybox mktemp "$profile/.core-options.XXXXXX")
        /bin/busybox cp /etc/console/retroarch-core-options.cfg "$pending"
        /bin/busybox mv -f "$pending" "$options"
    fi
    export HOME="$profile" XDG_CONFIG_HOME="$profile"
    exec /system/bin/retroarch --menu --config "$config"
    ;;
  netplay)
    test "$#" = 6
    case "$2" in host|join) ;; *) exit 2 ;; esac
    test -r "$4" && test -r "$5" && test -r "$6"
    runtime=/run/console/netplay-runtime
    /bin/busybox mkdir "$runtime" || exit 22
    ra= monitor=
    netplay_cleanup() {
        status=$?; trap - EXIT; trap '' INT TERM
        printf 'finishing\n' >"$runtime/phase"
        # A tracked frontend must exit and flush normally before its parent
        # exits or any supervisor writer-drain barrier can be released.
        if [ -n "$ra" ]; then kill -INT "$ra" 2>/dev/null || :; wait "$ra" 2>/dev/null || :; ra=; fi
        if [ -n "$monitor" ]; then kill -TERM "$monitor" 2>/dev/null || :; wait "$monitor" 2>/dev/null || :; monitor=; fi
        /bin/busybox tail -n 48 "$runtime/retroarch.log" >>/run/console/easy-netplay.log 2>/dev/null || :
        /bin/busybox rm -f "$runtime/controller.map" "$runtime/controls.cfg" "$runtime/audio-ready" "$runtime/exit-request" "$runtime/phase" "$runtime/retroarch.log"
        /bin/busybox rmdir "$runtime" 2>/dev/null || :
        exit "$status"
    }
    netplay_stop() {
        trap '' INT TERM
        status=0
        if [ -n "$ra" ]; then kill -INT "$ra" 2>/dev/null || :; wait "$ra" || status=$?; ra=; fi
        exit "$status"
    }
    trap netplay_cleanup EXIT
    trap netplay_stop INT TERM
    saves="$card/Saves/Netplay"
    for path in "$card/Saves" "$saves" "$saves/saves" "$saves/states"; do
        test ! -L "$path"
        /bin/busybox mkdir -p "$path"
    done
    config=/run/console/netplay.cfg
    pending=$(/bin/busybox mktemp /run/console/netplay.XXXXXX)
    /bin/busybox awk -v easy="${CLOVE_EASY_NETPLAY:-0}" '
        easy && /^(netplay_ip_port|netplay_nat_traversal)[[:space:]]*=/ { next }
        !/^(savefile_directory|savestate_directory|history_list_enable|netplay_public_announce|netplay_use_mitm_server|input_menu_toggle_btn|libretro_info_path|libretro_directory|core_info_cache_enable)[[:space:]]*=/ { print }
    ' "$4" >"$pending"
    {
        printf 'savefile_directory = "%s/saves"\nsavestate_directory = "%s/states"\n' "$saves" "$saves"
        printf 'history_list_enable = "false"\nnetplay_public_announce = "false"\nnetplay_use_mitm_server = "false"\n'
        printf 'libretro_info_path = "/system/share/console/core-info"\n'
        printf 'libretro_directory = "%s"\ncore_info_cache_enable = "false"\n' "$(/bin/busybox dirname "$5")"
        printf 'input_menu_toggle_btn = "19"\n'
        # The pinned legacy Neo Geo core is marked "serialized" upstream.
        # Onion permits its rollback Netplay. Limit this session policy to the
        # checksummed compatibility build; do not change ordinary core metadata.
        case "$5" in /system/lib/libretro/onion-4.3.1-1/fbalpha2012_neogeo_libretro.so)
            printf 'core_info_savestate_bypass = "true"\n' ;;
        esac
        if [ "${CLOVE_EASY_NETPLAY:-0}" = 1 ]; then
            printf 'netplay_ip_port = "55435"\nnetplay_nat_traversal = "false"\n'
        fi
    } >>"$pending"
    /bin/busybox mv -f "$pending" "$config"
    /system/bin/console-netplay-input --standard >"$runtime/controls.cfg" || exit 29
    pending=$(/bin/busybox mktemp /run/console/netplay.XXXXXX)
    /bin/busybox awk 'NR==FNR { key=$0;sub(/[[:space:]]*=.*/,"",key);replace[key]=1;next }
        { key=$0;sub(/^[[:space:]]*/,"",key);sub(/[[:space:]]*=.*/,"",key);if(!(key in replace))print }' \
        "$runtime/controls.cfg" "$config" >"$pending"
    /bin/busybox cat "$runtime/controls.cfg" >>"$pending"
    /bin/busybox mv "$pending" "$config"
    SDL_GAMECONTROLLERCONFIG=$(/bin/busybox cat "$runtime/controller.map")
    export SDL_GAMECONTROLLERCONFIG
    printf 'starting-emulator\n' >"$runtime/phase"
    if [ "$2" = host ]; then
        /system/bin/retroarch --verbose --config "$config" --host -L "$5" "$6" >"$runtime/retroarch.log" 2>&1 & ra=$!
    else
        /system/bin/retroarch --verbose --config "$config" --connect "$3" -L "$5" "$6" >"$runtime/retroarch.log" 2>&1 & ra=$!
    fi
    printf 'emulator-running\n' >"$runtime/phase"
    monitor_netplay() {
        trap 'exit 0' TERM
        audio_ready= exit_sent=
        while kill -0 "$ra" 2>/dev/null; do
            if [ -z "$audio_ready" ] && /bin/busybox grep -q '\[Audio\]: Started .*audio driver' "$runtime/retroarch.log"; then
                printf 'ready\n' >"$runtime/audio-ready"; audio_ready=1
            fi
            if [ -z "$exit_sent" ] && [ -f "$runtime/exit-request" ]; then
                kill -INT "$ra" 2>/dev/null || :; exit_sent=1
            fi
            /bin/busybox sleep 0.1
        done
    }
    monitor_netplay & monitor=$!
    status=0; wait "$ra" || status=$?; ra=
    exit "$status"
    ;;
  advance)
    test -x /system/bin/advmenu
    profile="$base/standalone-advance"
    test ! -L "$profile"
    /bin/busybox mkdir -p "$profile"
    config="$profile/advmenu.rc"
    test ! -L "$config"
    if [ ! -e "$config" ]; then
        pending="$profile/.advmenu.rc.new"
        test ! -L "$pending"
        /bin/busybox cp /etc/console/advmenu.rc "$pending"
        /bin/busybox mv -f "$pending" "$config"
    fi
    test -f "$config"
    export ADVANCE="$profile"
    exec /system/bin/advmenu
    ;;
  *) exit 2 ;;
esac
