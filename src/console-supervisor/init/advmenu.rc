device_video sdl
device_video_output window
display_size 640x480
device_keyboard sdl
device_joystick sdl
config save_at_exit
misc_exit esc
mode text
event_assign enter enter or joy_button1
event_assign esc esc or joy_button2
event_assign up up or joy_button14
event_assign down down or joy_button17
event_assign left left or joy_button15
event_assign right right or joy_button16
event_assign menu tab or joy_button10
emulator "ARCADE" generic "/system/bin/console-advance-launch" "%p"
emulator_roms "ARCADE" "/mnt/SDCARD/Roms/ARCADE"
emulator_roms_filter "ARCADE" "*.zip:*.7z:*.nes:*.fds:*.sfc:*.smc:*.gb:*.gbc:*.gba:*.gg:*.md:*.gen:*.bin:*.sms:*.pce:*.chd:*.cue:*.m3u:*.pbp:*.iso:*.cso:*.z64:*.n64:*.v64:*.gdi:*.cdi"
