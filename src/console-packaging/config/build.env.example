# Trusted Bash configuration, sourced by build_all.sh. Copy and edit on Linux.
# These are examples, not paths discovered or used on this Windows computer.
TINA_TOOLCHAIN_BIN=/srv/tina-sdk/toolchain/bin
TINA_SYSROOT=/srv/tina-sdk/sysroot
TINA_TRIPLET=aarch64-tina-linux
RETROARCH_SOURCE=/srv/src/RetroArch
RETROARCH_CONFIGURE_ARGS=/srv/board/retroarch.configure.args
BUILD_ROOT=/srv/build/magicx
JOBS=4

# Retain Cortex-A53 and the exact SDK ABI. Additional flags are trusted input.
TINA_EXTRA_CFLAGS=
TINA_EXTRA_LDFLAGS=
# Optional colon-separated target .pc directories, all inside TINA_SYSROOT.
# TINA_PKG_CONFIG_LIBDIR=/srv/tina-sdk/sysroot/usr/lib/pkgconfig:/srv/tina-sdk/sysroot/usr/share/pkgconfig
