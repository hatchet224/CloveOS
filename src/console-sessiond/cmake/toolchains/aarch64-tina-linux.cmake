# Use the *matching vendor SDK/sysroot*, not the build host's libc headers.
# TINA_TOOLCHAIN_PREFIX is an absolute prefix ending in '-' (or a PATH prefix).
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_VERSION 4.9)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(TINA_TOOLCHAIN_PREFIX "$ENV{TINA_TOOLCHAIN_PREFIX}" CACHE STRING "Vendor cross-compiler prefix")
set(TINA_SYSROOT "$ENV{TINA_SYSROOT}" CACHE PATH "Tina glibc 2.29 target sysroot")
if(TINA_TOOLCHAIN_PREFIX STREQUAL "" OR NOT IS_DIRECTORY "${TINA_SYSROOT}")
    message(FATAL_ERROR "Set TINA_TOOLCHAIN_PREFIX and TINA_SYSROOT to your Tina SDK")
endif()
find_program(TINA_C_COMPILER NAMES "${TINA_TOOLCHAIN_PREFIX}gcc" NO_CMAKE_FIND_ROOT_PATH)
if(NOT TINA_C_COMPILER)
    message(FATAL_ERROR "Cannot find ${TINA_TOOLCHAIN_PREFIX}gcc")
endif()
set(CMAKE_C_COMPILER "${TINA_C_COMPILER}")
set(CMAKE_SYSROOT "${TINA_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${TINA_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a53")
# Propagate SDK settings into CMake's nested compiler probes.
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TINA_TOOLCHAIN_PREFIX TINA_SYSROOT)
