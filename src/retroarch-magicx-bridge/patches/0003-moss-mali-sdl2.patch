 static void sdl2_gfx_free(void *data);
+
+/* Moss's vendor SDL Mali backend promotes NPOT backing textures and accepts
+ * SHOWN-only windows. Keep these adaptations out of every other SDL backend. */
+#define SDL2_FLAG_MOSS_MALI (1U << 2)
+
+static unsigned sdl2_window_flags(bool moss_mali, bool fullscreen,
+      bool windowed_fullscreen)
+{
+   if (moss_mali)
+      return SDL_WINDOW_SHOWN;
+   if (fullscreen)
+      return windowed_fullscreen ? SDL_WINDOW_FULLSCREEN_DESKTOP : SDL_WINDOW_FULLSCREEN;
+   return SDL_WINDOW_RESIZABLE;
+}
+
+static bool sdl2_moss_geometry(sdl2_video_t *vid, int *width, int *height,
+      int *scanout_rotation)
+{
+   if (SDL_GetRendererOutputSize(vid->renderer, width, height) != 0 ||
+       *width < 1 || *height < 1 || *width > 16384 || *height > 16384)
+      return false;
+   /* Same clockwise portrait convention as the Zero 28 MinUI platform. */
+   *scanout_rotation = *height > *width ? 90 : 0;
+   return true;
+}
+
+static bool sdl2_moss_upload(SDL_Texture *texture, const void *pixels,
+      unsigned width, unsigned height, unsigned pitch, bool rgb32, bool menu)
+{
+   SDL_Rect logical = {0, 0, (int)width, (int)height};
+   Uint32 format, expected = menu ?
+      (rgb32 ? SDL_PIXELFORMAT_ARGB8888 : SDL_PIXELFORMAT_RGBA4444) :
+      (rgb32 ? SDL_PIXELFORMAT_ARGB8888 : SDL_PIXELFORMAT_RGB565);
+   int access, backing_width, backing_height;
+   if (!texture || !pixels || !width || !height || width > 16384 || height > 16384 ||
+       pitch > INT_MAX || (uint64_t)pitch < (uint64_t)width * (rgb32 ? 4U : 2U) ||
+       SDL_QueryTexture(texture, &format, &access, &backing_width, &backing_height) != 0 ||
+       format != expected || access != SDL_TEXTUREACCESS_STREAMING ||
+       backing_width < (int)width || backing_height < (int)height ||
+       backing_width > 16384 || backing_height > 16384)
+      return false;
+   /* NULL would upload the padded allocation, overreading the core's buffer. */
+   return SDL_UpdateTexture(texture, &logical, pixels, (int)pitch) == 0;
+}
+
+static bool sdl2_moss_copy(sdl2_video_t *vid, SDL_Texture *texture,
+      const SDL_Rect *source, const SDL_Rect *logical_destination, double rotation)
+{
+   SDL_Rect destination;
+   int width, height, scanout_rotation;
+   if (!texture || !source || !logical_destination || source->x < 0 || source->y < 0 ||
+       source->w < 1 || source->h < 1 ||
+       logical_destination->w < 1 || logical_destination->h < 1 ||
+       !sdl2_moss_geometry(vid, &width, &height, &scanout_rotation))
+      return false;
+   destination = *logical_destination;
+   if (scanout_rotation)
+   {
+      /* Rotate around the physical output centre, retaining the game viewport's
+       * logical aspect ratio and centring. This also handles portrait letterbox. */
+      destination.x += (width - height) / 2;
+      destination.y += (height - width) / 2;
+   }
+   return SDL_RenderCopyEx(vid->renderer, texture, source, &destination,
+         rotation + scanout_rotation, NULL, SDL_FLIP_NONE) == 0;
+}
 
