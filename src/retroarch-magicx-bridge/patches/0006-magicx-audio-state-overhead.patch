+
+static size_t sdl_audio_buffer_size(void *data)
+{
+   sdl_audio_t *sdl = (sdl_audio_t*)data;
+   size_t capacity;
+   if (!sdl || !sdl->speaker_buffer)
+      return 0;
+   SDL_LockAudioDevice(sdl->speaker_device);
+   capacity = FIFO_READ_AVAIL(sdl->speaker_buffer) +
+         FIFO_WRITE_AVAIL(sdl->speaker_buffer);
+   SDL_UnlockAudioDevice(sdl->speaker_device);
+   return capacity;
 }
 
