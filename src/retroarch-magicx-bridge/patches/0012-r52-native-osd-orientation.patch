+/* Text uses logical landscape pixels on the physically portrait Zero 28 LCD.
+ * Keep all viewport/projection state private to the OSD draw. */
+static void gl2_clove_font_dimensions(gl2_t *gl, unsigned *width, unsigned *height)
+{
+   *width=gl->vp.width;*height=gl->vp.height;
+#ifdef HAVE_MAGICX_BRIDGE
+   if(magicx_retroarch_portrait_menu(gl->video_width,gl->video_height))
+   {unsigned swap=*width;*width=*height;*height=swap;}
+#endif
+}
+static void gl2_clove_font_mvp(gl2_t *gl)
+{
+#ifdef HAVE_MAGICX_BRIDGE
+   if(magicx_retroarch_portrait_menu(gl->video_width,gl->video_height))
+   {
+      math_matrix_4x4 rotation={{0}}, projected;
+      MAT_ELEM_4X4(rotation,0,1)=1.0f;
+      MAT_ELEM_4X4(rotation,1,0)=-1.0f;
+      MAT_ELEM_4X4(rotation,3,3)=1.0f;
+      matrix_4x4_multiply(projected,rotation,gl->mvp_no_rot);
+      gl->shader->set_mvp(gl->shader_data,&projected);
+      return;
+   }
+#endif
+   gl->shader->set_mvp(gl->shader_data,&gl->mvp_no_rot);
+}
+
