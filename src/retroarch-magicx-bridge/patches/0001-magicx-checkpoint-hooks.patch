diff --git a/tasks/task_save.c b/tasks/task_save.c
index c21be14..cbb539d 100644
--- a/tasks/task_save.c
+++ b/tasks/task_save.c
@@ -48,6 +48,9 @@
 #include "../runloop.h"
 #include "../verbosity.h"
 #include "tasks_internal.h"
+#ifdef HAVE_MAGICX_BRIDGE
+#include "../magicx/magicx_retroarch.h"
+#endif
 
 #ifdef EMSCRIPTEN
 /* Filesystem is in-memory anyway, use huge chunks since each
@@ -1823,3 +1826,36 @@ void set_save_state_in_background(bool state)
 {
    save_state_in_background = state;
 }
+
+#ifdef HAVE_MAGICX_BRIDGE
+/* Expose the native serializer, not content_save_state()'s enqueue-only result.
+ * Serialization stays on the runloop thread; MagicX owns a separate durable
+ * writer task because the legacy writer truncates and has no fsync contract. */
+bool content_magicx_snapshot(void **data, size_t *size, size_t maximum)
+{
+   size_t core_size = core_serialize_size();
+   size_t total;
+   if (!data || !size || !core_info_current_supports_savestate() ||
+       core_size == 0 || core_size > maximum || maximum < 32)
+      return false;
+   *data = NULL;
+   *size = 0;
+   total = content_get_serialized_size();
+   if (total == 0 || total > maximum)
+      return false;
+   *data = content_get_serialized_data(size);
+   if (!*data || *size > maximum)
+   {
+      free(*data);
+      *data = NULL;
+      *size = 0;
+      return false;
+   }
+   return true;
+}
+
+bool content_magicx_legacy_save_busy(void)
+{
+   return content_save_state_in_progress(NULL);
+}
+#endif
